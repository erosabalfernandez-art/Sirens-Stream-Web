{
  "installCommand": "npm install -g pnpm && pnpm install --no-frozen-lockfile",
  "buildCommand": "BASE_PATH=/ pnpm --filter @workspace/sirens-stream run build",
  "outputDirectory": "artifacts/sirens-stream/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
